generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                 String              @id
  name               String
  slug               String              @unique
  logo               String?
  createdAt          DateTime
  metadata           String?
  members            Member[]
  invitations        Invitation[]
  exceptions         ExceptionRecord[]
  pendingEvaluations PendingEvaluation[]
  refunds            RefundRecord[]
  invoiceRecords     InvoiceRecord[]
  inventoryAdjustments InventoryAdjustmentRecord[]
  shipments          ShipmentRecord[]
  webhookReceipts    WebhookReceipt[]
  executedActions    ExecutedAction[]
  auditLogEntries    AuditLogEntry[]
  caseBriefs         CaseBrief[]
  subscription       Subscription?
  processedOrders    ProcessedOrder[]
  billingInvoices    BillingInvoice[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model ExceptionRecord {
  id         String   @id
  orgId      String
  code       String
  orderId    String
  detectedAt DateTime
  status     String
  context    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@map("exceptions")
}

model PendingEvaluation {
  id        String   @id
  orgId     String
  kind      String
  dueAt     DateTime
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([dueAt])
  @@index([orgId])
  @@map("pending_evaluations")
}

model RefundRecord {
  id       String
  orgId    String
  orderId  String
  amount   Float
  currency String
  issuedAt DateTime
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, orderId])
  @@map("refund_records")
}

model InvoiceRecord {
  id       String
  orgId    String
  orderId  String
  issuedAt DateTime
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, orderId])
  @@map("invoice_records")
}

model InventoryAdjustmentRecord {
  id         String
  orgId      String
  orderId    String
  refundId   String
  quantity   Int
  adjustedAt DateTime
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, orderId])
  @@map("inventory_adjustment_records")
}

model ShipmentRecord {
  id                 String
  orgId              String
  orderId            String
  status             String
  lastStatusChangeAt DateTime
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, orderId])
  @@map("shipment_records")
}

model CaseBrief {
  orgId         String
  exceptionId   String
  locale        String
  summary       String
  recommendation String
  rationale     String
  modelId       String
  promptVersion String
  inputHash     String
  generatedAt   DateTime @default(now())
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, exceptionId, locale])
  @@map("case_briefs")
}

model WebhookReceipt {
  provider   String
  eventId    String
  orgId      String
  status     String   @default("PROCESSING")
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([provider, eventId])
  @@index([orgId, receivedAt])
  @@map("webhook_receipts")
}

model ExecutedAction {
  idempotencyKey String   @id
  exceptionId    String   @unique
  orgId          String?
  orderId        String?
  actionKind     String?
  status         String
  result         Json?
  error          String?
  attempts       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([exceptionId])
  @@unique([orgId, orderId, actionKind])
  @@map("executed_actions")
}

model AuditLogEntry {
  id           String   @id @default(cuid())
  orgId        String
  exceptionId  String?
  actor        String
  reason       String
  reasonSource String   @default("human")
  before       Json
  after        Json
  at           DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([orgId, exceptionId])
  @@map("audit_log_entries")
}

// One subscription per organization. Created automatically (trialing) when the organization is
// created — see BetterAuthService's afterCreateOrganization hook and BillingService.ensureTrial.
model Subscription {
  orgId              String    @id
  planCode           String
  status             String
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  stripeCustomerId       String?
  stripeSubscriptionId   String? @unique
  canceledAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

// One row per paid order actually counted toward a plan's monthly order limit. Deduplicated by
// (orgId, provider, externalOrderId) so replayed/duplicate provider webhooks never double-count.
model ProcessedOrder {
  orgId          String
  provider       String
  externalOrderId String
  amountCents    Int
  currency       String
  paidAt         DateTime
  ingestedAt     DateTime @default(now())
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, provider, externalOrderId])
  @@index([orgId, paidAt])
  @@map("billing_processed_orders")
}

// Stripe webhook events, deduplicated by Stripe's event id — mirrors WebhookReceipt for the
// provider webhooks, but scoped to billing events which may arrive before we can resolve orgId.
model BillingWebhookReceipt {
  provider   String
  eventId    String
  orgId      String?
  status     String   @default("PROCESSING")
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([provider, eventId])
  @@index([orgId, receivedAt])
  @@map("billing_webhook_receipts")
}

model BillingInvoice {
  id                 String   @id
  orgId              String
  stripeInvoiceId    String   @unique
  amountCents        Int
  currency           String
  status             String
  hostedInvoiceUrl   String?
  fiscalDocumentUrl  String?
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("billing_invoices")
}
